# ==========================================
# LeadFlowAI Production & Development Env
# ==========================================

# --- DATABASE (Required) ---
# PostgreSQL connection string (Render, Supabase, Neon, or local Docker)
DATABASE_URL=postgresql://leadflow:leadflow@localhost:5432/leadflowai

# --- SECURITY & AUTHENTICATION (Required) ---
# 32+ character secret key for JWT access token signing (generate via: openssl rand -hex 32)
SECRET_KEY=replace-with-a-secure-32-byte-hex-secret-key-for-jwt-signing

# --- CORS ORIGINS (Required for Web Deployments) ---
# Comma-separated list of allowed frontend origins (or * for unrestricted)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,https://leadflow-ai-red-sigma.vercel.app

# --- AI QUALIFICATION (Required for AI Scoring) ---
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here
OPENROUTER_MODEL=openai/gpt-4o-mini
AI_REQUEST_TIMEOUT_SECONDS=30

# --- PUBLIC LEAD INGEST (Optional) ---
# Allows landing pages/forms to POST to /api/v1/public/leads
PUBLIC_INGEST_ENABLED=true
# Optional API key for public lead ingest (leave blank to allow open form submissions)
PUBLIC_INGEST_API_KEY=
PUBLIC_INGEST_DEFAULT_USER_ID=1

# --- OUTBOUND WEBHOOKS (Optional) ---
N8N_WEBHOOK_ENABLED=false
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/lead-qualified
N8N_WEBHOOK_SECRET=your-hmac-webhook-secret-key
N8N_WEBHOOK_TIMEOUT_SECONDS=10

# --- TRANSACTIONAL EMAIL (Optional) ---
EMAIL_ENABLED=false
EMAIL_PROVIDER=smtp
# SMTP settings (e.g. Gmail App Password, Brevo, SendGrid)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=notifications@yourdomain.com
# SendGrid settings (if EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=

# --- FRONTEND CLIENT CONFIGURATION ---
# Optional: Set on Vercel/frontend host if API is on a separate domain
VITE_API_URL=https://your-backend.onrender.com